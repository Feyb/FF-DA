{
  "name": "@ff/draft-assistant-frontend",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "ng": "ng",
    "ktc:sync": "node ./scripts/fetch-ktc-players.mjs",
    "flock:sync": "node ./scripts/fetch-flock-players.mjs",
    "fp:sync": "node ./scripts/fetch-fantasypros-adp.mjs",
    "fc:sync": "node ./scripts/fetch-fantasycalc.mjs",
    "ffc:sync": "node ./scripts/fetch-ffc-adp.mjs",
    "sleeper:stats:sync": "node ./scripts/fetch-sleeper-stats.mjs",
    "nflverse:player-stats:sync": "node ./scripts/fetch-nflverse-player-stats.mjs",
    "nflverse:pfr:sync": "node ./scripts/fetch-nflverse-pfr-advstats.mjs",
    "nflverse:ngs:sync": "node ./scripts/fetch-nflverse-ngs.mjs",
    "nflverse:ff-opp:sync": "node ./scripts/fetch-nflverse-ff-opportunity.mjs",
    "nflverse:draft-picks:sync": "node ./scripts/fetch-nflverse-draft-picks.mjs",
    "nflverse:combine:sync": "node ./scripts/fetch-nflverse-combine.mjs",
    "nflverse:rosters:sync": "node ./scripts/fetch-nflverse-rosters.mjs",
    "espn:rosters:sync": "node ./scripts/fetch-espn-rosters.mjs",
    "nflverse:sync": "pnpm run --parallel \"/^nflverse:(player-stats|pfr|ngs|ff-opp|draft-picks|combine|rosters):sync$/\"",
    "cfbd:sync": "node ./scripts/fetch-cfbd-rookies.mjs",
    "rankings:sync": "pnpm run --parallel \"/^(ktc|flock|fp|fc|ffc|sleeper:stats|nflverse:(player-stats|pfr|ngs|ff-opp|draft-picks|combine|rosters)|espn:rosters|cfbd):sync$/\"",
    "start": "ng serve",
    "start-sync": "pnpm run rankings:sync && ng serve",
    "build": "pnpm run rankings:sync && ng build",
    "build:ci": "ng build",
    "deploy": "ng deploy",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:ng": "ng lint",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check ."
  },
  "dependencies": {
    "@angular/animations": "^21.2.14",
    "@angular/cdk": "^21.2.13",
    "@angular/common": "^21.2.14",
    "@angular/compiler": "^21.2.14",
    "@angular/core": "^21.2.14",
    "@angular/forms": "^21.2.14",
    "@angular/material": "^21.2.13",
    "@angular/platform-browser": "^21.2.14",
    "@angular/platform-browser-dynamic": "^21.2.14",
    "@angular/router": "^21.2.14",
    "@angular/service-worker": "^21.2.14",
    "@ngrx/operators": "^21.1.0",
    "@ngrx/signals": "^21.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.16.2"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.13",
    "@angular/cli": "^21.2.13",
    "@angular/compiler-cli": "^21.2.14",
    "@types/jasmine": "~5.1.0",
    "angular-cli-ghpages": "^2.0.2",
    "autoprefixer": "^10.4.0",
    "jasmine-core": "~5.4.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "oxfmt": "^0.45.0",
    "oxlint": "^1.15.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "~5.9.3"
  }
}
